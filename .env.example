# Copy to .env and adjust. Never commit .env.

# local | staging | production
APP_ENV=local
FLASK_APP=app:create_app

# Required in staging and production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite by default. PostgreSQL for staging/production, for example:
#   DATABASE_URL=postgresql://user:password@host:5432/fleet_compliance
DATABASE_URL=

# Name shown in the header and on the provider dashboard.
PROVIDER_NAME=High Plains Compliance Co.

# Demo login switcher and mock Motive data. Must be false in production.
DEMO_MODE=true

# Motive ELD API key (not used in demo mode). Never hard-code it.
MOTIVE_API_KEY=

# Set to true when served over HTTPS.
SESSION_COOKIE_SECURE=false
